%% F3 - Architecture: modules around the shared case record (horizontal)
flowchart LR
  M([Message]):::ext --> RD
  subgraph RD["Reading &mdash; Agent 1"]
    direction TB
    E1["Understand<br/>the message"]:::agent
    E2["Match to<br/>symptom terms"]:::agent
    E1 --> E2
  end
  RD --> REC{{"Shared case record<br/>the common contract"}}:::record
  REC --> CORE
  subgraph CORE["Decision core"]
    direction TB
    E4["Route by age"]:::core
    E6["Decide urgency<br/>or abstain"]:::core
    E7["Prioritise<br/>within a level"]:::core
    E4 --> E6 --> E7
  end
  CORE --> REC
  REC --> ACT
  subgraph ACT["Acting &mdash; Agent 3"]
    direction TB
    E10["Route to<br/>a facility"]:::proc
    E11["Handoff<br/>summary"]:::proc
    E10 --> E11
  end
  ACT --> V([Per-role<br/>views]):::ext
  REC -. "case stream" .-> SURV["Surveillance &mdash; Agent 2<br/>reads the stream only"]:::agent
  E6 -. follow-up .-> E6

  classDef ext fill:#EEF0F3,stroke:#8A9099,color:#2F343A;
  classDef agent fill:#ECE6F6,stroke:#5E4B8B,color:#2E2150;
  classDef core fill:#E6F0E9,stroke:#3C8A5A,color:#17402A;
  classDef proc fill:#E7EEF7,stroke:#3B6098,color:#16314F;
  classDef record fill:#FBF1DD,stroke:#B7892B,color:#4A3A10;
