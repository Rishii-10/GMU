%% F4 - The pipeline as a forward flow (arrows connect box-to-box)
flowchart LR
  M([Message]):::ext --> R["Read &rarr;<br/>case record"]:::agent
  R --> AGE{Age?}:::core
  AGE -- child --> PED["Children's<br/>danger-sign rules"]:::core
  AGE -- adult --> GATE["Decide urgency<br/>or abstain"]:::core
  GATE --> SZ{"commit /<br/>ask / defer"}:::core
  SZ -- commit --> LAB["Urgency<br/>level"]:::proc
  SZ -- ask --> FU["Follow-up:<br/>one question"]:::core
  FU -- answer --> GATE
  PED --> OV{{"danger sign &rarr;<br/>force emergency"}}:::alert
  LAB --> OV
  OV --> RT["Prioritise<br/>&amp; route"]:::proc
  RT --> V([Per-role<br/>views]):::ext

  classDef ext fill:#EEF0F3,stroke:#8A9099,color:#2F343A;
  classDef agent fill:#ECE6F6,stroke:#5E4B8B,color:#2E2150;
  classDef core fill:#E6F0E9,stroke:#3C8A5A,color:#17402A;
  classDef proc fill:#E7EEF7,stroke:#3B6098,color:#16314F;
  classDef alert fill:#F8E8E7,stroke:#B4453F,color:#5A1A17;
