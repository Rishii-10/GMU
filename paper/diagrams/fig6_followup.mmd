%% F7 - The active-follow-up loop (single row; arrows connect box-to-box)
flowchart LR
  EN([uncertain]):::ext --> SEL["Choose the most<br/>useful question"]:::core
  SEL --> ASK["Ask it in the<br/>caller's language"]:::agent
  ASK --> UP["Read reply,<br/>update the case"]:::core
  UP --> RE{"resolved?"}:::core
  RE -- yes --> OUT([decide]):::ext
  RE -- no --> SEL

  classDef ext fill:#EEF0F3,stroke:#8A9099,color:#2F343A;
  classDef agent fill:#ECE6F6,stroke:#5E4B8B,color:#2E2150;
  classDef core fill:#E6F0E9,stroke:#3C8A5A,color:#17402A;
